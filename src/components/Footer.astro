---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <p class="footer-promise">Nothing leaves your device.</p>
    <nav class="footer-links" aria-label="Footer">
      <a href="/video">Video</a>
      <a href="/pdf">PDF</a>
      <a href="/image">Image</a>
      <a href="/devices">Devices</a>
      <a href="https://github.com/nabeel-ncz/tools" rel="noopener">Source</a>
    </nav>
    <p class="footer-meta readout">© {year} NABL Tools</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-9);
    padding: var(--space-6) 0;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer-promise {
    font-family: var(--font-display);
    font-style: italic;
    margin: 0;
    color: var(--fg-soft);
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--fg-soft);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  .footer-meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }
</style>

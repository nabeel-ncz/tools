---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import ScreenRecorder from '../tools/screen-recorder/ScreenRecorder.svelte';

const tool = await getEntry('tools', 'screen-recorder');
if (!tool) throw new Error('Missing tools/screen-recorder content entry');
---

<ToolLayout tool={tool}>
  <ScreenRecorder slot="tool" client:visible />
</ToolLayout>

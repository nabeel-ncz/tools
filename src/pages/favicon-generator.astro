---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import FaviconGenerator from '../tools/favicon-generator/FaviconGenerator.svelte';

const tool = await getEntry('tools', 'favicon-generator');
if (!tool) throw new Error('Missing tools/favicon-generator content entry');
---

<ToolLayout tool={tool}>
  <FaviconGenerator slot="tool" client:visible />
</ToolLayout>

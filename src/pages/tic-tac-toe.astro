---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import TicTacToe from '../tools/tic-tac-toe/TicTacToe.svelte';

const tool = await getEntry('tools', 'tic-tac-toe');
if (!tool) throw new Error('Missing tools/tic-tac-toe content entry');
---

<ToolLayout tool={tool}>
  <TicTacToe slot="tool" client:visible />
</ToolLayout>

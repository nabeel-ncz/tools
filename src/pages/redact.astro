---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import Redact from '../tools/redact/Redact.svelte';

const tool = await getEntry('tools', 'redact');
if (!tool) throw new Error('Missing tools/redact content entry');
---

<ToolLayout tool={tool}>
  <Redact slot="tool" client:visible />
</ToolLayout>

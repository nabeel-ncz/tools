---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import SplitPdf from '../tools/split-pdf/SplitPdf.svelte';

const tool = await getEntry('tools', 'split-pdf');
if (!tool) throw new Error('Missing tools/split-pdf content entry');
---

<ToolLayout tool={tool}>
  <SplitPdf slot="tool" client:visible />
</ToolLayout>

---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import Transcriber from '../tools/transcribe/Transcriber.svelte';

const tool = await getEntry('tools', 'transcribe');
if (!tool) throw new Error('Missing tools/transcribe content entry');
---

<ToolLayout tool={tool}>
  <Transcriber slot="tool" client:visible />
</ToolLayout>

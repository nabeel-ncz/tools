---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import ScreenshotBeautifier from '../tools/screenshot-beautifier/ScreenshotBeautifier.svelte';

const tool = await getEntry('tools', 'screenshot-beautifier');
if (!tool) throw new Error('Missing tools/screenshot-beautifier content entry');
---

<ToolLayout tool={tool}>
  <ScreenshotBeautifier slot="tool" client:visible />
</ToolLayout>

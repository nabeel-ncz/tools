---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import PdfCompressor from '../tools/pdf-compressor/PdfCompressor.svelte';

const tool = await getEntry('tools', 'pdf-compressor');
if (!tool) throw new Error('Missing tools/pdf-compressor content entry');
---

<ToolLayout tool={tool}>
  <PdfCompressor slot="tool" client:visible />
</ToolLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLiveTools, toolUrl, CATEGORIES } from '../../lib/tools';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const info = CATEGORIES[category as string];
const tools = (await getLiveTools()).filter((t) => t.data.category === category);

const title = `${info.title} Tools — Free, Private, No Upload | NABL Tools`;
const description = info.intro.slice(0, 150);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tools.nabl.in/' },
    { '@type': 'ListItem', position: 2, name: info.title, item: `https://tools.nabl.in/${category}` },
  ],
};
---

<BaseLayout title={title} description={description} breadcrumbJsonLd={breadcrumbJsonLd}>
  <section class="wrap hub-hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{info.title}</li>
      </ol>
    </nav>
    <h1>{info.title}</h1>
    <p class="hub-intro">{info.intro}</p>
  </section>

  <div class="wrap">
    <ol class="catalogue-list">
      {
        tools.map((tool) => (
          <li class="catalogue-row">
            <a href={toolUrl(tool.slug)} class="catalogue-link">
              <span class="cat-serial readout">No. {tool.data.serial}</span>
              <span class="cat-title">{tool.data.title}</span>
              <span class="cat-purpose">{tool.data.oneLine}</span>
              <span class="cat-arrow" aria-hidden="true">
                &#8594;
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .hub-hero {
    padding-block: var(--space-6) var(--space-7);
  }

  .breadcrumbs ol {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--fg-faint);
    text-decoration: none;
  }

  .hub-intro {
    max-width: 60ch;
    font-size: var(--text-md);
  }

  .catalogue-list {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .catalogue-row {
    border-bottom: 1px solid var(--border);
  }

  .catalogue-link {
    display: grid;
    grid-template-columns: 4.5em 1fr 2fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    text-decoration: none;
    color: var(--fg);
    transition: background var(--duration-tick) var(--ease-snap);
  }

  .catalogue-link:hover {
    background: var(--bg-raised);
  }

  .cat-serial {
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
  }

  .cat-purpose {
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  .cat-arrow {
    color: var(--fg-faint);
  }

  @media (max-width: 700px) {
    .catalogue-link {
      grid-template-columns: 3.5em 1fr;
      grid-template-areas: 'serial title' '. purpose';
    }
    .cat-serial {
      grid-area: serial;
    }
    .cat-title {
      grid-area: title;
    }
    .cat-purpose {
      grid-area: purpose;
    }
    .cat-arrow {
      display: none;
    }
  }
</style>

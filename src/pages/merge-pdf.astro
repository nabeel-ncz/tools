---
import { getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import MergePdf from '../tools/merge-pdf/MergePdf.svelte';

const tool = await getEntry('tools', 'merge-pdf');
if (!tool) throw new Error('Missing tools/merge-pdf content entry');
---

<ToolLayout tool={tool}>
  <MergePdf slot="tool" client:visible />
</ToolLayout>
